{
  "name": "@open-flow/ui",
  "version": "0.3.0",
  "description": "A live workbench over your Next.js app — real components, tokens, and flows. The open-flow viewer, open source.",
  "license": "Elastic-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ecorona-LLC/open-flow.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    },
    "./actions": {
      "types": "./dist/dev-actions.d.ts",
      "development": "./dist/dev-actions.js",
      "default": "./dist/dev-actions.noop.js"
    },
    "./demo": {
      "types": "./dist/demo.d.ts",
      "default": "./dist/demo.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./overlay": {
      "types": "./dist/overlay.d.ts",
      "development": "./dist/overlay.js",
      "default": "./dist/overlay.noop.js"
    },
    "./overlay/noop": {
      "types": "./dist/overlay.noop.d.ts",
      "default": "./dist/overlay.noop.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/minify.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.11.10",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.6.2",
  "homepage": "https://github.com/Ecorona-LLC/open-flow"
}
